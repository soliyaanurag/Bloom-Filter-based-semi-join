+								   struct ExplainState *es);
+extern PlannedStmt *pgfdw_semijoin_planner(Query *parse,
+										   const char *query_string,
+										   int cursorOptions,
+										   ParamListInfo boundParams);
+
 /* in shippable.c */
 extern bool is_builtin(Oid objectId);
 extern bool is_shippable(Oid objectId, Oid classId, PgFdwRelationInfo *fpinfo);
diff --git a/contrib/postgres_fdw/semijoin.c b/contrib/postgres_fdw/semijoin.c
new file mode 100644
index 0000000000..75be5a45fb
--- /dev/null
+++ b/contrib/postgres_fdw/semijoin.c
@@ -0,0 +1,2358 @@
+/*-------------------------------------------------------------------------
+ *
+ * semijoin.c
+ *		  CS631 project: automatic semijoin rewrite for postgres_fdw.
+ *
+ * Role of this file in the project
+ * --------------------------------
+ * Site A joins a local table R (orders) with a foreign table S (customers)
+ * that lives at site B. Normally postgres_fdw fetches ALL of S. This file
+ * installs a planner hook that looks at every query before it is planned
+ * and, for a simple join "local.key = foreign.key", adds one more condition
+ * on the foreign table, so that site B sends back only the rows that can
+ * match.
+ *
+ * The steps, for every query:
+ *   1. find_candidate: is it "local JOIN foreign ON local.k = foreign.k"
+ *      (int4) with safe conditions? If not, nothing changes.
+ *   2. collect_remote_stats: size of S, rows per key, width of a row on
+ *      the wire (from site A's statistics of the foreign table).
+ *   3. estimate_local_keys: how many distinct keys n will the local rows
+ *      have? (planner row estimate + the formula of PostgreSQL's
+ *      estimate_num_groups)
+ *   4. decide_path: index path or filter path (sjbloom's sjb_plan_choice,
+ *      or the setting postgres_fdw.semijoin_force_path).
+ *   5. the rewrite: one new condition on the foreign key is added to WHERE:
+ *        index path:  foreign.k = ANY ((SELECT array_agg(DISTINCT k)
+ *                                       FROM local WHERE ...))
+ *        filter path: sjb_contains((SELECT sjb_build_auto(array_agg(k), ...)
+ *                                   FROM local WHERE ...), foreign.k)
+ *      The planner turns the sub-SELECT into an InitPlan, and postgres_fdw
+ *      sends its result to site B as the parameter $1.
+ * The join itself is not changed, so the result is always exactly the
+ * same: the new condition only removes foreign rows that cannot join.
+ *
+ * If anything goes wrong in steps 2-5, the query is left unchanged: our
+ * feature never makes a query fail.
+ *
+ * IDENTIFICATION
+ *		  contrib/postgres_fdw/semijoin.c
+ *
+ *-------------------------------------------------------------------------
+ */
+#include "postgres.h"
+
+#include <math.h>
+
+#include "access/htup_details.h"
+#include "access/sysattr.h"
+#include "access/xact.h"
+#include "commands/explain_format.h"
+#include "commands/explain_state.h"
+#include "catalog/pg_class.h"
+#include "catalog/pg_operator.h"
+#include "catalog/pg_statistic.h"
+#include "catalog/pg_type.h"
+#include "commands/defrem.h"
+#include "commands/extension.h"
+#include "foreign/foreign.h"
+#include "lib/stringinfo.h"
+#include "nodes/makefuncs.h"
+#include "nodes/nodeFuncs.h"
+#include "optimizer/optimizer.h"
+#include "optimizer/planner.h"
+#include "parser/analyze.h"
+#include "parser/parse_func.h"
+#include "parser/parser.h"
+#include "parser/parsetree.h"
+#include "postgres_fdw.h"
+#include "rewrite/rewriteManip.h"
+#include "utils/builtins.h"
+#include "utils/guc.h"
+#include "utils/lsyscache.h"
+#include "utils/resowner.h"
+#include "utils/ruleutils.h"
+#include "utils/syscache.h"
+
+/*
+ * Width of one int4 join key as text on the wire. postgres_fdw sends
+ * values as text, and our ids have 6-7 digits (see CLAUDE.md: pg_stats
+ * says 4 bytes, the stored width, which is wrong for the wire).
+ */
+#define SJB_INT4_TEXT_WIDTH 7
+
+/*
+ * Protocol overhead of one returned row: a DataRow message has a 7-byte
+ * header and 4 bytes (a length) per column.
+ */
+#define SJB_ROW_OVERHEAD_BYTES 7
+#define SJB_COLUMN_OVERHEAD_BYTES 4
+
+/*
+ * wire_factor: bytes on the wire per filter byte. postgres_fdw sends a
+ * bytea parameter as hex text (2 characters per byte), or in binary (1)
+ * when postgres_fdw.semijoin_binary_filter is on (Batch 7).
+ */
+#define SJB_WIRE_FACTOR_TEXT 2.0
+#define SJB_WIRE_FACTOR_BINARY 1.0
+
+/* postgres_fdw's default fetch_size (rows per FETCH) */
+#define SJB_DEFAULT_FETCH_SIZE 100
+
+/*
+ * The planner hook that was installed before ours (or NULL). option.c sets
+ * it in _PG_init, and our hook calls it at the end.
+ */
+planner_hook_type prev_planner_hook = NULL;
+
+/*
+ * Batch 7: the hint for the query that is being planned right now, or
+ * NULL. pgfdw_semijoin_planner sets it just before it calls the planner
+ * and puts the old value back right after (also after an error), so it
+ * can never be seen while planning another query.
+ */
+SemijoinHint *pgfdw_semijoin_hint = NULL;
+
+/*
+ * True while our hook is running. If something inside our hook ever asks
+ * for a query to be planned, we must not start our own work again.
+ */
+static bool in_semijoin_hook = false;
+
+/*
+ * Everything find_candidate learns about a query that we can rewrite.
+ */
+typedef struct SjbCandidate
+{
+	/* the local table (R) */
+	Index		local_varno;	/* its position in q->rtable (1-based) */
+	Oid			local_relid;	/* its OID */
+	AttrNumber	local_attno;	/* column number of its join key */
+	char	   *local_alias;	/* its name in the query, e.g. "o" */
+	bool		local_inh;		/* false if the query said FROM ONLY */
+
+	/* the foreign table (S) */
+	Index		foreign_varno;
+	Oid			foreign_relid;
+	AttrNumber	foreign_attno;
+	Var		   *foreign_var;	/* the foreign side of "local = foreign" */
+
+	/* conditions that use only the local table (or no table at all) */
+	List	   *local_quals;
+
+	/* OID of the sjbloom extension at site A, and its schema's name */
+	Oid			sjbloom_oid;
+	char	   *sjbloom_schema;
+
+	/* filled in when the query is NOT a candidate: why not */
+	const char *reject_reason;
+
+	/* true if reject_reason must be shown even when verbose is off */
+	bool		always_report;
+
+	/* true if the query uses at least one foreign table */
+	bool		uses_foreign_table;
+
+	/* the function sjb_contains (set by build_filter_condition) */
+	Oid			contains_oid;
+
+	/* Batch 7: filled in by plan_semijoin when the query is rewritten */
+	SemijoinHint hint;
+} SjbCandidate;
+
+/*
+ * The numbers the cost model needs (steps 2 and 3).
+ */
+typedef struct SjbStats
+{
+	double		s_rows;			/* rows of the foreign table S */
+	double		d_remote;		/* distinct join keys in S */
+	double		rows_per_key;	/* s_rows / d_remote */
+	double		row_width;		/* bytes of one returned row on the wire */
+	int			num_columns;	/* foreign columns the query fetches */
+	int			fetch_size;		/* rows per FETCH (postgres_fdw option) */
+	double		r_local;		/* local rows after the local conditions */
+	double		n_local;		/* all rows of the local table (reltuples) */
+	double		d_local;		/* distinct join keys in the local table */
+	double		n_est;			/* estimated distinct keys we will send */
+} SjbStats;
+
+/*
+ * Used by table_refs_walker: which tables a condition uses.
+ */
+typedef struct TableRefs
+{
+	Index		local_varno;
+	Index		foreign_varno;
+	bool		uses_local;		/* a Var of the local table was found */
+	bool		uses_foreign;	/* a Var of the foreign table was found */
+	bool		uses_other;		/* a Var of another range table entry */
+} TableRefs;
+
+
+/*
+ * split_and_clauses
+ *
+ * What it does: splits a condition "A AND B AND C" into its parts and
+ * appends each part to *clauses. A condition that is not an AND is
+ * appended as it is.
+ *
+ * Inputs:  node    - a condition (may be NULL: then nothing is added)
+ *          clauses - the list to append to
+ * Output:  *clauses grows
+ *
+ * Why it exists: in the query tree, WHERE a AND b is one BoolExpr node.
+ * We want to look at each condition on its own.
+ */
+static void
+split_and_clauses(Node *node, List **clauses)
+{
+	if (node == NULL)
+		return;
+
+	/*
+	 * IsA(node, BoolExpr) checks the node's type tag. Every node in a
+	 * query tree starts with such a tag.
+	 */
+	if (IsA(node, BoolExpr) && ((BoolExpr *) node)->boolop == AND_EXPR)
+	{
+		BoolExpr   *and_expr = (BoolExpr *) node;
+		ListCell   *cell;
+
+		/* foreach walks a PostgreSQL List; lfirst(cell) is the element */
+		foreach(cell, and_expr->args)
+			split_and_clauses((Node *) lfirst(cell), clauses);
+		return;
+	}
+
+	/* lappend adds one element at the end of a List (NIL = empty list) */
+	*clauses = lappend(*clauses, node);
+}
+
+/*
+ * collect_join_tree_quals
+ *
+ * What it does: walks the FROM part of the query (the "join tree") and
+ * collects all conditions: the WHERE condition and the ON conditions of
+ * INNER JOINs.
+ *
+ * Inputs:  node    - a part of the join tree (FromExpr, JoinExpr or
+ *                    RangeTblRef)
+ *          clauses - the list to append the conditions to
+ * Output:  true if everything is fine; false if the join tree has
+ *          something we do not support (for example a LEFT JOIN)
+ *
+ * Why it exists: for an INNER JOIN, a condition written in ON means the
+ * same as in WHERE, so we treat both the same way. A LEFT/RIGHT/FULL
+ * join can NOT be rewritten: the foreign rows that we would remove may be
+ * needed (with NULLs) in the result.
+ */
+static bool
+collect_join_tree_quals(Node *node, List **clauses)
+{
+	ListCell   *cell;
+
+	if (node == NULL)
+		return true;
+
+	if (IsA(node, RangeTblRef))
+		return true;			/* just a table: no condition here */
+
+	if (IsA(node, FromExpr))
+	{
+		FromExpr   *from = (FromExpr *) node;
+
+		foreach(cell, from->fromlist)
+		{
+			if (!collect_join_tree_quals((Node *) lfirst(cell), clauses))
+				return false;
+		}
+		split_and_clauses(from->quals, clauses);
+		return true;
+	}
+
+	if (IsA(node, JoinExpr))
+	{
+		JoinExpr   *join = (JoinExpr *) node;
+
+		if (join->jointype != JOIN_INNER)
+			return false;
+		if (!collect_join_tree_quals(join->larg, clauses))
+			return false;
+		if (!collect_join_tree_quals(join->rarg, clauses))
+			return false;
+		split_and_clauses(join->quals, clauses);
+		return true;
+	}
+
+	return false;				/* unknown kind of node: do not risk it */
+}
+
+/*
+ * table_refs_walker
+ *
+ * What it does: looks at every node inside a condition and records in
+ * *refs which tables its column references (Vars) belong to.
+ *
+ * Inputs:  node - the current node; refs - the TableRefs to fill in
+ * Output:  always false (false means "keep walking")
+ *
+ * Why it exists: we must know if a condition uses only the local table,
+ * only the foreign table, or both. expression_tree_walker calls this
+ * function for every node of the expression.
+ */
+static bool
+table_refs_walker(Node *node, TableRefs *refs)
+{
+	if (node == NULL)
+		return false;
+
+	if (IsA(node, Var))
+	{
+		Var		   *var = (Var *) node;
+
+		/* varlevelsup > 0 would mean a Var of an outer query */
+		if (var->varlevelsup != 0)
+			refs->uses_other = true;
+		else if (var->varno == refs->local_varno)
+			refs->uses_local = true;
+		else if (var->varno == refs->foreign_varno)
+			refs->uses_foreign = true;
+		else
+			refs->uses_other = true;	/* e.g. a column of a JOIN entry */
+		return false;
+	}
+
+	return expression_tree_walker(node, table_refs_walker, refs);
+}
+
+/*
+ * contains_param_walker
+ *
+ * What it does: returns true if the expression contains a Param node (a
+ * query parameter such as $1 of a prepared statement).
+ *
+ * Inputs:  node - the expression; context - unused
+ * Output:  true if a Param was found
+ *
+ * Why it exists: we will copy local conditions into a new SQL text. A
+ * parameter has no value at that point, so we cannot copy it.
+ */
+static bool
+contains_param_walker(Node *node, void *context)
+{
+	if (node == NULL)
+		return false;
+	if (IsA(node, Param))
+		return true;
+	return expression_tree_walker(node, contains_param_walker, context);
+}
+
+/*
+ * contains_sjb_contains_walker
+ *
+ * What it does: returns true if the expression calls a function named
+ * sjb_contains.
+ *
+ * Inputs:  node - the expression; context - unused
+ * Output:  true if sjb_contains is called somewhere
+ *
+ * Why it exists: a query that already uses a semijoin filter (for example
+ * one written by hand, like queries/bloom_manual.sql) must not get a
+ * second one.
+ */
+static bool
+contains_sjb_contains_walker(Node *node, void *context)
+{
+	if (node == NULL)
+		return false;
+	if (IsA(node, FuncExpr))
+	{
+		FuncExpr   *func = (FuncExpr *) node;
+		char	   *name = get_func_name(func->funcid);
+
+		if (name != NULL && strcmp(name, "sjb_contains") == 0)
+			return true;
+	}
+	return expression_tree_walker(node, contains_sjb_contains_walker, context);
+}
+
+/*
+ * is_join_clause
+ *
+ * What it does: checks if a condition is exactly
+ * "local_column = foreign_column" with the int4 equality operator, and if
+ * so returns the two columns.
+ *
+ * Inputs:  clause - a condition; c - the candidate (tables already known)
+ * Output:  true if it is such a condition; then *local_var and
+ *          *foreign_var point to the two columns
+ *
+ * Why it exists: version 1 supports only one int4 equality join.
+ */
+static bool
+is_join_clause(Node *clause, SjbCandidate *c, Var **local_var, Var **foreign_var)
+{
+	OpExpr	   *op;
+	Var		   *left;
+	Var		   *right;
+
+	if (!IsA(clause, OpExpr))
+		return false;
+	op = (OpExpr *) clause;
+
+	/* Int4EqualOperator is the OID of "int4 = int4" (from pg_operator) */
+	if (op->opno != Int4EqualOperator || list_length(op->args) != 2)
+		return false;
+
+	/* linitial / lsecond are the first / second element of a List */
+	if (!IsA(linitial(op->args), Var) || !IsA(lsecond(op->args), Var))
+		return false;
+	left = (Var *) linitial(op->args);
+	right = (Var *) lsecond(op->args);
+
+	if (left->varlevelsup != 0 || right->varlevelsup != 0)
+		return false;
+
+	if (left->varno == c->local_varno && right->varno == c->foreign_varno)
+	{
+		*local_var = left;
+		*foreign_var = right;
+		return true;
+	}
+	if (left->varno == c->foreign_varno && right->varno == c->local_varno)
+	{
+		*local_var = right;
+		*foreign_var = left;
+		return true;
+	}
+	return false;
+}
+
+/*
+ * find_tables
+ *
+ * What it does: looks at the query's range table (the list of tables and
+ * joins in FROM) and finds the one local table and the one foreign table.
+ *
+ * Inputs:  q - the query; c - the candidate to fill in
+ * Output:  true if there are exactly one local table and one foreign
+ *          table (plus any number of JOIN entries); c->local_* and
+ *          c->foreign_* are set
+ *
+ * Why it exists: version 1 supports only "one local table JOIN one
+ * foreign table".
+ */
+static bool
+find_tables(Query *q, SjbCandidate *c)
+{
+	ListCell   *cell;
+	int			num_relations = 0;
+	Index		rt_index = 0;
+
+	foreach(cell, q->rtable)
+	{
+		RangeTblEntry *rte = (RangeTblEntry *) lfirst(cell);
+
+		rt_index++;
+		/*
+		 * A JOIN entry is not a table: ignore it. The same for the GROUP
+		 * entry that PostgreSQL 18 adds for GROUP BY: our new condition
+		 * goes into WHERE, which runs before grouping, and only removes
+		 * foreign rows that cannot join, so the groups do not change.
+		 */
+		if (rte->rtekind == RTE_JOIN || rte->rtekind == RTE_GROUP)
+			continue;
+		if (rte->rtekind != RTE_RELATION)
+		{
+			c->reject_reason = "the query uses something other than tables (subquery, function, ...)";
+			return false;
+		}
+
+		num_relations++;
+		if (rte->relkind == RELKIND_FOREIGN_TABLE)
+		{
+			c->foreign_varno = rt_index;
+			c->foreign_relid = rte->relid;
+		}
+		else if (rte->relkind == RELKIND_RELATION)
+		{
+			/*
+			 * Row-level security adds hidden conditions (securityQuals). We
+			 * would read the table again without them, so we do not try.
+			 * TABLESAMPLE picks random rows: reading the table twice would
+			 * not give the same rows (same problem as volatile functions).
+			 */
+			if (rte->securityQuals != NIL || rte->tablesample != NULL)
+			{
+				c->reject_reason = "the local table has row-level security or TABLESAMPLE";
+				return false;
+			}
+			c->local_varno = rt_index;
+			c->local_relid = rte->relid;
+			c->local_alias = rte->eref->aliasname;
+			c->local_inh = rte->inh;
+		}
+	}
+
+	if (num_relations != 2 || c->local_varno == 0 || c->foreign_varno == 0)
+	{
+		c->reject_reason = "the query does not join exactly one local table with one foreign table";
+		return false;
+	}
+	return true;
+}
+
+/*
+ * server_allows_semijoin
+ *
+ * What it does: checks that the foreign table belongs to postgres_fdw,
+ * that the option semijoin_filter is true for it, and that the server's
+ * "extensions" option lists sjbloom.
+ *
+ * Inputs:  c - the candidate (foreign_relid and sjbloom_oid are set)
+ * Output:  true if all three hold
+ *
+ * Why it exists: the feature is opt-in per server or per table, and the
+ * filter function can only be sent to site B if postgres_fdw is told that
+ * sjbloom is installed there ("extensions" option).
+ */
+static bool
+server_allows_semijoin(SjbCandidate *c)
+{
+	ForeignTable *table = GetForeignTable(c->foreign_relid);
+	ForeignServer *server = GetForeignServer(table->serverid);
+	ForeignDataWrapper *wrapper = GetForeignDataWrapper(server->fdwid);
+	char	   *handler_name;
+	bool		semijoin_filter = false;
+	bool		sjbloom_listed = false;
+	ListCell   *cell;
+
+	handler_name = get_func_name(wrapper->fdwhandler);
+	if (handler_name == NULL || strcmp(handler_name, "postgres_fdw_handler") != 0)
+	{
+		c->reject_reason = "the foreign table does not use postgres_fdw";
+		return false;
+	}
+
+	/* Server options: semijoin_filter and extensions. */
+	foreach(cell, server->options)
+	{
+		/* each option is a DefElem: a name (defname) and a value */
+		DefElem    *def = (DefElem *) lfirst(cell);
+
+		if (strcmp(def->defname, "semijoin_filter") == 0)
+			semijoin_filter = defGetBoolean(def);
+		if (strcmp(def->defname, "extensions") == 0)
+		{
+			List	   *extension_oids = ExtractExtensionList(defGetString(def), false);
+
+			if (list_member_oid(extension_oids, c->sjbloom_oid))
+				sjbloom_listed = true;
+		}
+	}
+
+	/* A table option semijoin_filter overrides the server's value. */
+	foreach(cell, table->options)
+	{
+		DefElem    *def = (DefElem *) lfirst(cell);
+
+		if (strcmp(def->defname, "semijoin_filter") == 0)
+			semijoin_filter = defGetBoolean(def);
+	}
+
+	if (!semijoin_filter)
+	{
+		c->reject_reason = "semijoin_filter is not true for this server/table";
+		return false;
+	}
+	if (!sjbloom_listed)
+	{
+		c->reject_reason = "the server's \"extensions\" option does not list sjbloom";
+		return false;
+	}
+	return true;
+}
+
+/*
+ * check_conditions
+ *
+ * What it does: looks at every condition of the query. It must find
+ * exactly one join condition "local.key = foreign.key" (int4), and every
+ * other condition must use only one of the two tables. Conditions on the
+ * local table are saved in c->local_quals.
+ *
+ * Inputs:  q - the query; c - the candidate (tables already known)
+ * Output:  true if the conditions are fine
+ *
+ * Why it exists: these are the rules that make the rewrite safe.
+ */
+static bool
+check_conditions(Query *q, SjbCandidate *c)
+{
+	List	   *clauses = NIL;
+	ListCell   *cell;
+	int			num_join_clauses = 0;
+
+	if (!collect_join_tree_quals((Node *) q->jointree, &clauses))
+	{
+		c->reject_reason = "the query uses a join that is not an INNER JOIN";
+		return false;
+	}
+
+	foreach(cell, clauses)
+	{
+		Node	   *clause = (Node *) lfirst(cell);
+		Var		   *local_var;
+		Var		   *foreign_var;
+		TableRefs	refs;
+
+		if (contains_sjb_contains_walker(clause, NULL))
+		{
+			c->reject_reason = "the query already uses sjb_contains";
+			return false;
+		}
+
+		if (is_join_clause(clause, c, &local_var, &foreign_var))
+		{
+			num_join_clauses++;
+			c->local_attno = local_var->varattno;
+			c->foreign_attno = foreign_var->varattno;
+			c->foreign_var = foreign_var;
+			continue;
+		}
+
+		/*
+		 * A subquery (SubLink) may refer to any table, which our simple
+		 * walker cannot see reliably. We do not try.
+		 */
+		if (checkExprHasSubLink(clause))
+		{
+			c->reject_reason = "a condition contains a subquery";
+			return false;
+		}
+
+		memset(&refs, 0, sizeof(refs));
+		refs.local_varno = c->local_varno;
+		refs.foreign_varno = c->foreign_varno;
+		table_refs_walker(clause, &refs);
+
+		if (refs.uses_other || (refs.uses_local && refs.uses_foreign))
+		{
+			c->reject_reason = "another condition uses both tables";
+			return false;
+		}
+		if (refs.uses_foreign)
+			continue;			/* a condition on S alone: not our business */
+
+		/*
+		 * A condition on the local table alone (or on no table, like
+		 * "random() < 2"). We will copy it into the subquery that reads the
+		 * local table a SECOND time to collect the join keys. That is only
+		 * correct if both reads select exactly the same rows:
+		 *  - a volatile function (random(), clock_timestamp(), ...) may
+		 *    give a different answer on each read, so the key list could
+		 *    miss keys of rows the main query keeps, and the join would
+		 *    lose result rows;
+		 *  - a parameter ($1) has no value yet, so we cannot copy it.
+		 */
+		if (contain_volatile_functions(clause))
+		{
+			c->reject_reason = "a local condition contains a volatile function";
+			return false;
+		}
+		if (contains_param_walker(clause, NULL))
+		{
+			c->reject_reason = "a local condition contains a parameter ($n)";
+			return false;
+		}
+		c->local_quals = lappend(c->local_quals, clause);
+	}
+
+	if (num_join_clauses != 1)
+	{
+		c->reject_reason = "there is not exactly one \"local int4 = foreign int4\" join condition";
+		return false;
+	}
+	return true;
+}
+
+/*
+ * query_uses_foreign_table
+ *
+ * What it does: returns true if any table in the query is a foreign table.
+ * Input:  q - the query
+ * Output: true or false
+ * Why it exists: with verbose on, we explain why a query is not rewritten
+ * only for queries that use a foreign table (otherwise every catalog query
+ * of psql would print a NOTICE).
+ */
+static bool
+query_uses_foreign_table(Query *q)
+{
+	ListCell   *cell;
+
+	foreach(cell, q->rtable)
+	{
+		RangeTblEntry *rte = (RangeTblEntry *) lfirst(cell);
+
+		if (rte->rtekind == RTE_RELATION && rte->relkind == RELKIND_FOREIGN_TABLE)
+			return true;
+	}
+	return false;
+}
+
+/*
+ * find_candidate
+ *
+ * What it does: decides if a query can be rewritten into a semijoin.
+ *
+ * Inputs:  q - the query, as the planner receives it
+ *          c - filled in with everything we learn
+ * Output:  true only if ALL of these hold:
+ *   - it is a plain SELECT (no UNION/INTERSECT/EXCEPT, no FOR UPDATE, no
+ *     data-modifying WITH)
+ *   - FROM has exactly one local table and one postgres_fdw foreign table
+ *   - semijoin_filter = true for the foreign table (server or table) and
+ *     the server's "extensions" option lists sjbloom
+ *   - the sjbloom extension is installed here at site A
+ *   - only INNER joins, exactly one "local int4 = foreign int4" condition,
+ *     no other condition that uses both tables, no sjb_contains yet
+ *   - local conditions have no volatile functions, subqueries or params
+ *   If it returns false, c->reject_reason says why.
+ *
+ * Why it exists: the rewrite must only happen when it is certainly safe.
+ */
+static bool
+find_candidate(Query *q, SjbCandidate *c)
+{
+	memset(c, 0, sizeof(SjbCandidate));
+	c->uses_foreign_table = query_uses_foreign_table(q);
+
+	if (!c->uses_foreign_table)
+	{
+		c->reject_reason = "the query uses no foreign table";
+		return false;
+	}
+
+	if (q->commandType != CMD_SELECT || q->utilityStmt != NULL ||
+		q->setOperations != NULL || q->rowMarks != NIL || q->hasModifyingCTE)
+	{
+		c->reject_reason = "the query is not a plain SELECT";
+		return false;
+	}
+
+	if (!find_tables(q, c))
+		return false;
+
+	/* get_extension_oid(name, true) returns InvalidOid if it is missing */
+	c->sjbloom_oid = get_extension_oid("sjbloom", true);
+	if (!OidIsValid(c->sjbloom_oid))
+	{
+		c->reject_reason = "the sjbloom extension is not installed here";
+		return false;
+	}
+
+	if (!server_allows_semijoin(c))
+		return false;
+
+	if (!check_conditions(q, c))
+		return false;
+
+	return true;
+}
+
+
+
+/* ------------------------------------------------------------------------
+ * Step 2: statistics of the foreign table
+ * ------------------------------------------------------------------------
+ */
+
+/*
+ * get_reltuples
+ *
+ * What it does: reads pg_class.reltuples (the row count that ANALYZE
+ * stored) of a table.
+ *
+ * Inputs:  relid - the table's OID
+ * Output:  the row count; -1 if the table was never analyzed (or if it
+ *          cannot be found)
+ *
+ * Why it exists: we need |S| (and |R|) for the cost model.
+ */
+static double
+get_reltuples(Oid relid)
+{
+	HeapTuple	tuple;
+	double		reltuples;
+
+	/*
+	 * SearchSysCache1 looks up one catalog row through PostgreSQL's catalog
+	 * cache; RELOID = pg_class by OID. GETSTRUCT gives the row's fields as a
+	 * C struct. Every found row must be given back with ReleaseSysCache.
+	 */
+	tuple = SearchSysCache1(RELOID, ObjectIdGetDatum(relid));
+	if (!HeapTupleIsValid(tuple))
+		return -1;
+	reltuples = ((Form_pg_class) GETSTRUCT(tuple))->reltuples;
+	ReleaseSysCache(tuple);
+	return reltuples;
+}
+
+/*
+ * get_n_distinct
+ *
+ * What it does: reads the number of distinct values of one column from
+ * pg_statistic (stadistinct, shown as n_distinct in pg_stats).
+ *
+ * Inputs:  relid, attno - the table and the column
+ *          reltuples    - the table's row count
+ * Output:  the number of distinct values (at least 1); 0 if there are no
+ *          statistics
+ *
+ * Why it exists: stadistinct > 0 is a count, but stadistinct < 0 means
+ * "a fraction of the rows" (-0.5 = half of the rows are distinct), so it
+ * must be multiplied by the row count.
+ */
+static double
+get_n_distinct(Oid relid, AttrNumber attno, double reltuples)
+{
+	HeapTuple	tuple;
+	double		stadistinct;
+	double		n_distinct;
+
+	/* STATRELATTINH = pg_statistic by (table, column, inherited?) */
+	tuple = SearchSysCache3(STATRELATTINH,
+							ObjectIdGetDatum(relid),
+							Int16GetDatum(attno),
+							BoolGetDatum(false));
+	if (!HeapTupleIsValid(tuple))
+		return 0;
+	stadistinct = ((Form_pg_statistic) GETSTRUCT(tuple))->stadistinct;
+	ReleaseSysCache(tuple);
+
+	if (stadistinct > 0)
+		n_distinct = stadistinct;
+	else if (stadistinct < 0)
+		n_distinct = -stadistinct * reltuples;
+	else
+		return 0;				/* 0 means "unknown" */
+
+	if (n_distinct < 1)
+		n_distinct = 1;
+	return n_distinct;
+}
+
+/*
+ * column_text_width
+ *
+ * What it does: estimates how many bytes one value of a column takes as
+ * TEXT (postgres_fdw sends rows as text).
+ *
+ * Inputs:  relid, attno - the table and the column
+ * Output:  the width in bytes
+ *
+ * Why it exists: for int4, pg_stats says 4 (the stored width), but on the
+ * wire our ids are about 7 characters. For other types (text, ...) the
+ * stored average width from pg_stats is close to the text width.
+ */
+static double
+column_text_width(Oid relid, AttrNumber attno)
+{
+	Oid			type_id;
+	int32		typmod;
+	Oid			collation;
+	int32		width;
+
+	get_atttypetypmodcoll(relid, attno, &type_id, &typmod, &collation);
+	if (type_id == INT4OID)
+		return SJB_INT4_TEXT_WIDTH;
+
+	/* get_attavgwidth = pg_stats.avg_width (0 if there are no stats) */
+	width = get_attavgwidth(relid, attno);
+	if (width <= 0)
+		width = get_typavgwidth(type_id, typmod);	/* a guess by type */
+	return width;
+}
+
+/*
+ * foreign_columns_used
+ *
+ * What it does: returns the set of columns of the foreign table that the
+ * query uses: in the SELECT list, in the conditions, in GROUP BY and
+ * HAVING, plus the join column.
+ *
+ * Inputs:  q - the query; c - the candidate
+ * Output:  a Bitmapset of column numbers. pull_varattnos stores column
+ *          number attno as member (attno - FirstLowInvalidHeapAttributeNumber),
+ *          so that system columns (negative numbers) fit too.
+ *
+ * Why it exists: postgres_fdw fetches only these columns, so only they
+ * count in the width of a returned row.
+ */
+static Bitmapset *
+foreign_columns_used(Query *q, SjbCandidate *c)
+{
+	Bitmapset  *columns = NULL;
+	ListCell   *cell;
+
+	pull_varattnos((Node *) q->targetList, c->foreign_varno, &columns);
+	pull_varattnos((Node *) q->jointree, c->foreign_varno, &columns);
+	pull_varattnos(q->havingQual, c->foreign_varno, &columns);
+
+	/*
+	 * With GROUP BY, the SELECT list refers to the GROUP entry, and the
+	 * GROUP entry's groupexprs refer to the real columns.
+	 */
+	foreach(cell, q->rtable)
+	{
+		RangeTblEntry *rte = (RangeTblEntry *) lfirst(cell);
+
+		if (rte->rtekind == RTE_GROUP)
+			pull_varattnos((Node *) rte->groupexprs, c->foreign_varno, &columns);
+	}
+
+	columns = bms_add_member(columns,
+							 c->foreign_attno - FirstLowInvalidHeapAttributeNumber);
+	return columns;
+}
+
+/*
+ * get_fetch_size
+ *
+ * What it does: returns postgres_fdw's fetch_size for the foreign table
+ * (table option, else server option, else 100).
+ *
+ * Input:  c - the candidate
+ * Output: rows per FETCH
+ *
+ * Why it exists: the cost model counts one message per FETCH, so it must
+ * use the same fetch_size as postgres_fdw itself.
+ */
+static int
+get_fetch_size(SjbCandidate *c)
+{
+	ForeignTable *table = GetForeignTable(c->foreign_relid);
+	ForeignServer *server = GetForeignServer(table->serverid);
+	int			fetch_size = SJB_DEFAULT_FETCH_SIZE;
+	int			value;
+	ListCell   *cell;
+
+	/* server first, then the table (the table's value wins) */
+	foreach(cell, server->options)
+	{
+		DefElem    *def = (DefElem *) lfirst(cell);
+
+		/* parse_int reads an integer from text; false if it is not one */
+		if (strcmp(def->defname, "fetch_size") == 0 &&
+			parse_int(defGetString(def), &value, 0, NULL) && value > 0)
+			fetch_size = value;
+	}
+	foreach(cell, table->options)
+	{
+		DefElem    *def = (DefElem *) lfirst(cell);
+
+		if (strcmp(def->defname, "fetch_size") == 0 &&
+			parse_int(defGetString(def), &value, 0, NULL) && value > 0)
+			fetch_size = value;
+	}
+	return fetch_size;
+}
+
+/*
+ * collect_remote_stats
+ *
+ * What it does: fills in s_rows, d_remote, rows_per_key, row_width,
+ * num_columns and fetch_size.
+ *
+ * Inputs:  q - the query; c - the candidate; stats - to fill in
+ * Output:  true if all statistics are there; false (with
+ *          c->reject_reason) if not
+ *
+ * Why it exists: the cost model needs these numbers. They come from site
+ * A's own statistics of the foreign table (ANALYZE customers at site_a
+ * fetches a sample from site B), so no network call is needed here.
+ */
+static bool
+collect_remote_stats(Query *q, SjbCandidate *c, SjbStats *stats)
+{
+	Bitmapset  *columns;
+	int			member;
+	double		text_width = 0;
+
+	stats->s_rows = get_reltuples(c->foreign_relid);
+	if (stats->s_rows < 0)
+	{
+		/* psprintf = sprintf into newly allocated memory (palloc) */
+		c->reject_reason = psprintf("the foreign table has no statistics: run ANALYZE %s at site_a",
+									get_rel_name(c->foreign_relid));
+		c->always_report = true;
+		return false;
+	}
+	if (stats->s_rows == 0)
+	{
+		c->reject_reason = "the foreign table is empty";
+		return false;
+	}
+
+	stats->d_remote = get_n_distinct(c->foreign_relid, c->foreign_attno, stats->s_rows);
+	if (stats->d_remote <= 0)
+	{
+		c->reject_reason = psprintf("the foreign join column has no statistics: run ANALYZE %s at site_a",
+									get_rel_name(c->foreign_relid));
+		c->always_report = true;
+		return false;
+	}
+	stats->rows_per_key = stats->s_rows / stats->d_remote;
+
+	/* width on the wire: text widths + 7 + 4 * number of columns */
+	columns = foreign_columns_used(q, c);
+	stats->num_columns = 0;
+	member = -1;
+	while ((member = bms_next_member(columns, member)) >= 0)
+	{
+		AttrNumber	attno = member + FirstLowInvalidHeapAttributeNumber;
+
+		if (attno <= 0)
+		{
+			c->reject_reason = "the query uses a system column or a whole-row reference of the foreign table";
+			return false;
+		}
+		text_width += column_text_width(c->foreign_relid, attno);
+		stats->num_columns++;
+	}
+	stats->row_width = text_width + SJB_ROW_OVERHEAD_BYTES +
+		SJB_COLUMN_OVERHEAD_BYTES * stats->num_columns;
+
+	stats->fetch_size = get_fetch_size(c);
+	return true;
+}
+
+
+/* ------------------------------------------------------------------------
+ * Step 3: the sub-SELECT on the local table, and the estimate of n
+ * ------------------------------------------------------------------------
+ */
+
+/*
+ * local_key_text
+ *
+ * What it does: returns the SQL text of the local join key, for example
+ * o.customer_id (quoted if needed).
+ * Input:  c - the candidate
+ * Output: a new string
+ * Why it exists: the three sub-SELECTs all need it.
+ */
+static char *
+local_key_text(SjbCandidate *c)
+{
+	/* quote_identifier adds "..." only when a name needs it */
+	return psprintf("%s.%s",
+					quote_identifier(c->local_alias),
+					quote_identifier(get_attname(c->local_relid, c->local_attno, false)));
+}
+
+/*
+ * build_local_select
+ *
+ * What it does: writes the SQL text
+ *     SELECT <select_list> FROM [ONLY] schema.table alias
+ *     WHERE alias.key IS NOT NULL AND (<local condition 1>) AND ...
+ *
+ * Inputs:  c           - the candidate (local table and its conditions)
+ *          select_list - the SELECT list text, e.g. "o.customer_id"
+ * Output:  the SQL text
+ *
+ * Why it exists: the estimate (step 3) and both rewrites (step 5) read
+ * the same local rows R'. "key IS NOT NULL" is added because a NULL key
+ * never joins.
+ */
+static char *
+build_local_select(SjbCandidate *c, const char *select_list)
+{
+	StringInfoData sql;
+	List	   *deparse_context;
+	char	   *alias = (char *) quote_identifier(c->local_alias);
+	char	   *table_name;
+	ListCell   *cell;
+
+	table_name = quote_qualified_identifier(get_namespace_name(get_rel_namespace(c->local_relid)),
+											get_rel_name(c->local_relid));
+
+	/* A StringInfo is a growing string; appendStringInfo works like printf. */
+	initStringInfo(&sql);
+	appendStringInfo(&sql, "SELECT %s FROM %s%s %s WHERE %s IS NOT NULL",
+					 select_list,
+					 c->local_inh ? "" : "ONLY ",
+					 table_name,
+					 alias,
+					 local_key_text(c));
+
+	/*
+	 * Turn each local condition back into SQL text. In the new query the
+	 * local table is range table entry number 1, so first we copy the
+	 * condition (copyObject) and renumber its Vars to 1 (ChangeVarNodes).
+	 * deparse_expression then prints it, using "alias." before columns.
+	 */
+	deparse_context = deparse_context_for(c->local_alias, c->local_relid);
+	foreach(cell, c->local_quals)
+	{
+		Node	   *qual = copyObject((Node *) lfirst(cell));
+
+		ChangeVarNodes(qual, c->local_varno, 1, 0);
+		appendStringInfo(&sql, " AND (%s)",
+						 deparse_expression(qual, deparse_context, true, false));
+	}
+	return sql.data;
+}
+
+/*
+ * parse_select
+ *
+ * What it does: turns SQL text into an analysed Query tree, exactly like
+ * PostgreSQL does for a query typed by a user.
+ *
+ * Input:  sql - one SELECT statement
+ * Output: the Query
+ *
+ * Why it exists: writing SQL text and parsing it is much simpler (and
+ * easier to read) than building a Query tree by hand.
+ */
+static Query *
+parse_select(const char *sql)
+{
+	List	   *raw_statements;
+
+	/* raw_parser: text -> syntax tree (one RawStmt per statement) */
+	raw_statements = raw_parser(sql, RAW_PARSE_DEFAULT);
+	if (list_length(raw_statements) != 1)
+		elog(ERROR, "semijoin: expected one statement in: %s", sql);
+
+	/* parse analysis: looks up tables, columns, functions and types */
+	return parse_analyze_fixedparams(linitial_node(RawStmt, raw_statements),
+									 sql, NULL, 0, NULL);
+}
+
+/*
+ * estimate_local_keys
+ *
+ * What it does: estimates n, the number of distinct non-NULL join keys of
+ * the local rows R'.
+ *   1. r = the planner's row estimate for
+ *          SELECT key FROM local WHERE key IS NOT NULL AND <local conditions>
+ *   2. N = all rows of the local table (reltuples), D = number of distinct
+ *      keys in the whole local table (n_distinct)
+ *   3. n_est = D * (1 - ((N - r) / N) ^ (N / D))
+ *
+ * This is the formula PostgreSQL itself uses in estimate_num_groups()
+ * (src/backend/utils/adt/selfuncs.c). Its comment there explains it:
+ *
+ *   "Given a table containing N rows with n distinct values in a
+ *    uniform distribution, if we select p rows at random then
+ *    the expected number of distinct values selected is
+ *
+ *    n * (1 - product((N-N/n-i)/(N-i), i=0..p-1))
+ *
+ *    = n * (1 - (N-N/n)! / (N-N/n-p)! * (N-p)! / N!)
+ *
+ *    See "Approximating block accesses in database
+ *    organizations", S. B. Yao, Communications of the ACM,
+ *    Volume 20 Issue 4, April 1977 Pages 260-261.
+ *
+ *    Alternatively, re-arranging the terms from the factorials,
+ *    this may be written as
+ *
+ *    n * (1 - product((N-p-i)/(N-i), i=0..N/n-1))
+ *
+ *    This form of the formula is more efficient to compute in
+ *    the common case where p is larger than N/n.  Additionally,
+ *    as pointed out by Dell'Era, if i << N for all terms in the
+ *    product, it can be approximated by
+ *
+ *    n * (1 - ((N-p)/N)^(N/n))
+ *
+ *    See "Expected distinct values when selecting from a bag
+ *    without replacement", Alberto Dell'Era,
+ *    http://www.adellera.it/investigations/distinct_balls/.
+ *
+ *    The condition i << N is equivalent to n >> 1, so this is a
+ *    good approximation when the number of distinct values in
+ *    the table is large.  It turns out that this formula also
+ *    works well even when n is small."
+ *
+ * (Their n is our D and their p is our r.) In Batch 6 we used Cardenas'
+ * formula D * (1 - (1 - 1/D)^r), which assumes the r rows are picked WITH
+ * replacement; it was 29% too low at r = 150,000 of N = 200,000 rows.
+ * Like PostgreSQL, we clamp D to N and use D itself when r >= N.
+ *
+ * Inputs:  c - the candidate; stats - r_local, n_local, d_local, n_est
+ *          are set
+ * Output:  none
+ *
+ * Why it exists: the real n is only known when the query runs, but the
+ * path must be chosen now, at plan time.
+ */
+static void
+estimate_local_keys(SjbCandidate *c, SjbStats *stats)
+{
+	char	   *sql = build_local_select(c, local_key_text(c));
+	Query	   *query = parse_select(sql);
+	PlannedStmt *plan;
+
+	/*
+	 * We call standard_planner directly, not planner(): planner() would
+	 * call our hook again.
+	 */
+	plan = standard_planner(query, sql, 0, NULL);
+	stats->r_local = plan->planTree->plan_rows;
+
+	stats->n_local = get_reltuples(c->local_relid);
+	stats->d_local = get_n_distinct(c->local_relid, c->local_attno,
+									stats->n_local);
+	if (stats->n_local <= 0 || stats->d_local <= 0)
+	{
+		/* no statistics: assume every row has its own key */
+		stats->n_est = stats->r_local;
+		return;
+	}
+
+	/* there cannot be more distinct keys than rows */
+	if (stats->d_local > stats->n_local)
+		stats->d_local = stats->n_local;
+
+	if (stats->r_local < stats->n_local)
+		stats->n_est = stats->d_local *
+			(1.0 - pow((stats->n_local - stats->r_local) / stats->n_local,
+					   stats->n_local / stats->d_local));
+	else
+		stats->n_est = stats->d_local;	/* all rows: all keys */
+
+	if (stats->n_est < 1)
+		stats->n_est = 1;
+}
+
+
+/* ------------------------------------------------------------------------
+ * Step 4: index path or filter path?
+ * ------------------------------------------------------------------------
+ */
+
+/*
+ * get_max_filter_bytes
+ *
+ * What it does: returns postgres_fdw.semijoin_max_filter_kb in bytes.
+ * Input:  none
+ * Output: the largest filter (BLOOM or EXACT) we may send, in bytes
+ * Why it exists: the same limit goes to sjb_plan_choice (plan time) and
+ * to sjb_build_auto (run time), so both decisions agree.
+ */
+static int64
+get_max_filter_bytes(void)
+{
+	return (int64) pgfdw_semijoin_max_filter_kb * 1024;
+}
+
+/*
+ * get_wire_factor
+ *
+ * What it does: returns 1 if the filter will be sent in binary
+ * (postgres_fdw.semijoin_binary_filter = on), else 2 (hex text).
+ * Input:  none
+ * Output: the wire factor
+ * Why it exists: all cost functions and sjb_build_auto must use the same.
+ */
+static double
+get_wire_factor(void)
+{
+	if (pgfdw_semijoin_binary_filter)
+		return SJB_WIRE_FACTOR_BINARY;
+	return SJB_WIRE_FACTOR_TEXT;
+}
+
+/*
+ * invoke_cost_function
+ *
+ * What it does: calls one of sjbloom's cost model SQL functions directly
+ * through fmgr, PostgreSQL's function call interface. They all take the
+ * same 12 arguments (see sjbloom--1.0.sql), then (Batch 7) the path name
+ * for sjb_expected_remote_rows and sjb_predicted_ms only, and last the
+ * wire_factor.
+ *
+ * Inputs:  c             - the candidate (sjbloom's schema)
+ *          function_name - e.g. "sjb_plan_choice"
+ *          stats         - the estimates (n = stats->n_est)
+ *          path          - NULL for sjb_plan_choice / sjb_choice_report,
+ *                          else "index" or "filter"
+ *          result        - set to the function's result
+ * Output:  true if the function exists and returned a value
+ *
+ * Why it exists: the cost model lives in ONE place (sjbloom's
+ * costmodel.c). We call it without SPI (no SQL query is run).
+ */
+static bool
+invoke_cost_function(SjbCandidate *c, const char *function_name,
+					 SjbStats *stats, const char *path, Datum *result)
+{
+	Oid			argument_types[14];
+	int			num_arguments = (path == NULL) ? 13 : 14;
+	int			wire_factor_argument = num_arguments - 1;	/* the last one */
+	Oid			function_oid;
+	FmgrInfo	function_info;
+	int			i;
+
+	/* LOCAL_FCINFO declares a FunctionCallInfo with room for 14 arguments */
+	LOCAL_FCINFO(fcinfo, 14);
+
+	for (i = 0; i < 10; i++)
+		argument_types[i] = FLOAT8OID;
+	argument_types[10] = INT4OID;	/* fetch_size */
+	argument_types[11] = INT8OID;	/* max_filter_bytes (Batch 6b) */
+	argument_types[12] = TEXTOID;	/* path (Batch 7), if there is one */
+	argument_types[wire_factor_argument] = FLOAT8OID;	/* wire_factor */
+
+	/* LookupFuncName finds a function by (schema, name) and argument types */
+	function_oid = LookupFuncName(list_make2(makeString(c->sjbloom_schema),
+											 makeString(pstrdup(function_name))),
+								  num_arguments, argument_types, true);
+	if (!OidIsValid(function_oid))
+		return false;
+
+	/* fmgr_info prepares the call; then we put the arguments in place */
+	fmgr_info(function_oid, &function_info);
+	InitFunctionCallInfoData(*fcinfo, &function_info, num_arguments,
+							 InvalidOid, NULL, NULL);
+
+	/* Float8GetDatum / Int32GetDatum / Int64GetDatum wrap a C value as a Datum */
+	fcinfo->args[0].value = Float8GetDatum(stats->n_est);
+	fcinfo->args[1].value = Float8GetDatum(stats->s_rows);
+	fcinfo->args[2].value = Float8GetDatum(stats->rows_per_key);
+	fcinfo->args[3].value = Float8GetDatum(stats->row_width);
+	fcinfo->args[4].value = Float8GetDatum(pgfdw_semijoin_network_mbit);
+	fcinfo->args[5].value = Float8GetDatum(pgfdw_semijoin_t_check_ns);
+	fcinfo->args[6].value = Float8GetDatum(pgfdw_semijoin_t_lookup_us);
+	fcinfo->args[7].value = Float8GetDatum(pgfdw_semijoin_per_message_ms);
+	fcinfo->args[8].value = Float8GetDatum(pgfdw_semijoin_per_row_us);
+	fcinfo->args[9].value = Float8GetDatum(pgfdw_semijoin_t_build_us);
+	fcinfo->args[10].value = Int32GetDatum(stats->fetch_size);
+	fcinfo->args[11].value = Int64GetDatum(get_max_filter_bytes());
+	if (path != NULL)
+		fcinfo->args[12].value = CStringGetTextDatum(path);	/* C string -> text */
+	fcinfo->args[wire_factor_argument].value = Float8GetDatum(get_wire_factor());
+	for (i = 0; i < num_arguments; i++)
+		fcinfo->args[i].isnull = false;
+
+	*result = FunctionCallInvoke(fcinfo);
+	return !fcinfo->isnull;
+}
+
+/*
+ * call_cost_function
+ *
+ * What it does: calls sjb_plan_choice or sjb_choice_report (12 arguments)
+ * and returns its text result.
+ * Inputs:  c, function_name, stats - as for invoke_cost_function
+ * Output:  the result text, or NULL if the function does not exist
+ * Why it exists: the decision and the verbose report are text.
+ */
+static char *
+call_cost_function(SjbCandidate *c, const char *function_name, SjbStats *stats)
+{
+	Datum		result;
+
+	if (!invoke_cost_function(c, function_name, stats, NULL, &result))
+		return NULL;
+	return text_to_cstring(DatumGetTextPP(result));
+}
+
+/*
+ * call_cost_number
+ *
+ * What it does: calls sjb_expected_remote_rows or sjb_predicted_ms for
+ * one path and returns the number.
+ * Inputs:  c, function_name, stats, path - as for invoke_cost_function;
+ *          value - set to the result
+ * Output:  true if it worked
+ * Why it exists: Batch 7's hint needs these numbers.
+ */
+static bool
+call_cost_number(SjbCandidate *c, const char *function_name, SjbStats *stats,
+				 const char *path, double *value)
+{
+	Datum		result;
+
+	if (!invoke_cost_function(c, function_name, stats, path, &result))
+		return false;
+	*value = DatumGetFloat8(result);	/* Datum -> C double */
+	return true;
+}
+
+/*
+ * fill_hint
+ *
+ * What it does: fills in the Batch 7 hint for a rewritten query: the
+ * foreign table, the path, n_est, the rows site B is expected to send
+ * back on that path, and both predicted times.
+ *
+ * Inputs:  c - the candidate (c->hint is filled in); stats; path
+ * Output:  true if sjbloom's functions could be called. If not, the hint
+ *          stays empty (foreign_relid = InvalidOid) and the planner keeps
+ *          its own row estimate; the rewrite itself still happens.
+ *
+ * Why it exists: postgres_fdw's row estimate and EXPLAIN read the hint.
+ */
+static bool
+fill_hint(SjbCandidate *c, SjbStats *stats, int path)
+{
+	SemijoinHint hint;
+	const char *path_name = (path == SEMIJOIN_PATH_INDEX) ? "index" : "filter";
+
+	memset(&hint, 0, sizeof(hint));
+	hint.foreign_relid = c->foreign_relid;
+	hint.foreign_attno = c->foreign_attno;
+	hint.contains_funcid = c->contains_oid;	/* InvalidOid on the index path */
+	hint.path = path;
+	hint.n_est = stats->n_est;
+
+	if (!call_cost_number(c, "sjb_expected_remote_rows", stats, path_name, &hint.expected_rows) ||
+		!call_cost_number(c, "sjb_predicted_ms", stats, "index", &hint.index_ms) ||
+		!call_cost_number(c, "sjb_predicted_ms", stats, "filter", &hint.filter_ms))
+		return false;
+
+	c->hint = hint;
+	return true;
+}
+
+/*
+ * decide_path
+ *
+ * What it does: chooses SEMIJOIN_PATH_INDEX or SEMIJOIN_PATH_FILTER.
+ *
+ * Inputs:  c - the candidate; stats - the estimates
+ * Output:  the path, or -1 (with c->reject_reason) if the cost model
+ *          could not be called
+ *
+ * Why it exists: postgres_fdw.semijoin_force_path (for tests and demos)
+ * wins; otherwise sjbloom's cost model decides.
+ */
+static int
+decide_path(SjbCandidate *c, SjbStats *stats)
+{
+	char	   *choice;
+
+	if (pgfdw_semijoin_force_path == SEMIJOIN_PATH_INDEX ||
+		pgfdw_semijoin_force_path == SEMIJOIN_PATH_FILTER)
+		return pgfdw_semijoin_force_path;
+
+	choice = call_cost_function(c, "sjb_plan_choice", stats);
+	if (choice != NULL && strcmp(choice, "index") == 0)
+		return SEMIJOIN_PATH_INDEX;
+	if (choice != NULL && strcmp(choice, "filter") == 0)
+		return SEMIJOIN_PATH_FILTER;
+
+	c->reject_reason = "sjb_plan_choice(13 arguments) could not be called: recreate sjbloom from its current SQL file";
+	return -1;
+}
+
+
+/* ------------------------------------------------------------------------
+ * Step 5: the new condition
+ * ------------------------------------------------------------------------
+ */
+
+/*
+ * make_expr_sublink
+ *
+ * What it does: wraps a Query as a scalar sub-SELECT "(SELECT ...)".
+ * Input:  subquery - the Query
+ * Output: a SubLink node of type EXPR_SUBLINK
+ * Why it exists: an EXPR_SUBLINK returns one value. Because it does not
+ * use any column of the outer query, the planner runs it only ONCE, as
+ * an "InitPlan", and postgres_fdw sends its value to site B as $1.
+ */
+static Node *
+make_expr_sublink(Query *subquery)
+{
+	/* makeNode allocates a new node (palloc) and sets its type tag */
+	SubLink    *sublink = makeNode(SubLink);
+
+	sublink->subLinkType = EXPR_SUBLINK;
+	sublink->subLinkId = 0;
+	sublink->testexpr = NULL;
+	sublink->operName = NIL;
+	sublink->subselect = (Node *) subquery;
+	sublink->location = -1;
+	return (Node *) sublink;
+}
+
+/*
+ * build_index_condition
+ *
+ * What it does: builds
+ *     foreign.key = ANY ((SELECT array_agg(DISTINCT o.key) FROM local o
+ *                         WHERE ...))
+ * as a ScalarArrayOpExpr (the node for "x = ANY (array)").
+ *
+ * Inputs:  c   - the candidate
+ *          sql - set to the text of the sub-SELECT (for the NOTICE)
+ * Output:  the condition
+ *
+ * Why it exists: on this path site B can use its index on the key.
+ */
+static Node *
+build_index_condition(SjbCandidate *c, char **sql)
+{
+	ScalarArrayOpExpr *any_expr = makeNode(ScalarArrayOpExpr);
+	Node	   *sublink;
+
+	*sql = build_local_select(c, psprintf("array_agg(DISTINCT %s)", local_key_text(c)));
+	sublink = make_expr_sublink(parse_select(*sql));
+
+	any_expr->opno = Int4EqualOperator;
+	any_expr->opfuncid = get_opcode(Int4EqualOperator);	/* int4eq */
+	any_expr->hashfuncid = InvalidOid;
+	any_expr->negfuncid = InvalidOid;
+	any_expr->useOr = true;		/* ANY (true for at least one element) */
+	any_expr->inputcollid = InvalidOid;
+	any_expr->args = list_make2(copyObject(c->foreign_var), sublink);
+	any_expr->location = -1;
+	return (Node *) any_expr;
+}
+
+/*
+ * build_filter_condition
+ *
+ * What it does: builds
+ *     sjb_contains((SELECT sjb_build_auto(array_agg(o.key), <s_rows>,
+ *                   <rows_per_key>, <row_width>, <network_mbit>,
+ *                   <t_check_ns>, <max_filter_bytes>, 2, <per_message_ms>,
+ *                   <per_row_us>, <t_build_us>, <fetch_size>)
+ *                   FROM local o WHERE ...),
+ *                  foreign.key)
+ *
+ * Inputs:  c     - the candidate
+ *          stats - the estimates (printed into the SQL text)
+ *          sql   - set to the text of the sub-SELECT (for the NOTICE)
+ * Output:  the condition, or NULL if sjb_contains cannot be found
+ *
+ * Why it exists: on this path site B scans S and keeps only rows whose
+ * key passes the filter. sjb_build_auto picks BLOOM, EXACT or PASS when
+ * the query runs, from the exact number of keys. array_agg has no
+ * DISTINCT: sjb_build_auto sorts and removes duplicates itself.
+ */
+static Node *
+build_filter_condition(SjbCandidate *c, SjbStats *stats, char **sql)
+{
+	Oid			contains_argument_types[2] = {BYTEAOID, INT4OID};
+	Oid			contains_oid;
+	long long	max_filter_bytes = (long long) get_max_filter_bytes();
+	char	   *build_call;
+	Node	   *sublink;
+
+	contains_oid = LookupFuncName(list_make2(makeString(c->sjbloom_schema),
+											 makeString("sjb_contains")),
+								  2, contains_argument_types, true);
+	if (!OidIsValid(contains_oid))
+	{
+		c->reject_reason = "function sjb_contains(bytea, int4) not found";
+		return NULL;
+	}
+	c->contains_oid = contains_oid;
+
+	/* %.17g prints a double with all its digits, so nothing is rounded */
+	build_call = psprintf("%s.sjb_build_auto(array_agg(%s), "
+						  "%.17g::float8, %.17g::float8, %.17g::float8, "
+						  "%.17g::float8, %.17g::float8, %lld::int8, "
+						  "%.17g::float8, %.17g::float8, %.17g::float8, "
+						  "%.17g::float8, %d::int4)",
+						  quote_identifier(c->sjbloom_schema),
+						  local_key_text(c),
+						  stats->s_rows,
+						  stats->rows_per_key,
+						  stats->row_width,
+						  pgfdw_semijoin_network_mbit,
+						  pgfdw_semijoin_t_check_ns,
+						  max_filter_bytes,
+						  get_wire_factor(),
+						  pgfdw_semijoin_per_message_ms,
+						  pgfdw_semijoin_per_row_us,
+						  pgfdw_semijoin_t_build_us,
+						  stats->fetch_size);
+	*sql = build_local_select(c, build_call);
+	sublink = make_expr_sublink(parse_select(*sql));
+
+	/* makeFuncExpr builds a function call node: sjb_contains(...) -> bool */
+	return (Node *) makeFuncExpr(contains_oid, BOOLOID,
+								 list_make2(sublink, copyObject(c->foreign_var)),
+								 InvalidOid, InvalidOid, COERCE_EXPLICIT_CALL);
+}
+
+/*
+ * report_decision
+ *
+ * What it does: prints the verbose NOTICE: the estimates, the two
+ * predicted times (the "winner:" line of sjb_choice_report) and the path.
+ *
+ * Inputs:  c, stats - the candidate and estimates; path - the chosen path;
+ *          sql - the sub-SELECT text
+ * Output:  none (a NOTICE)
+ * Why it exists: postgres_fdw.semijoin_verbose = on explains every
+ * decision.
+ */
+static void
+report_decision(SjbCandidate *c, SjbStats *stats, int path, const char *sql)
+{
+	char	   *report = call_cost_function(c, "sjb_choice_report", stats);
+	char	   *winner_line = NULL;
+
+	if (report != NULL)
+		winner_line = strstr(report, "winner:");
+
+	ereport(NOTICE,
+			(errmsg("postgres_fdw semijoin: %s path (%s): n_est=%.1f (r=%.0f, N=%.0f, D_local=%.0f), s_rows=%.0f, rows_per_key=%.3f, row_width=%.2f (%d columns), fetch_size=%d, max_filter_bytes=%lld",
+					path == SEMIJOIN_PATH_INDEX ? "index" : "filter",
+					pgfdw_semijoin_force_path == SEMIJOIN_PATH_AUTO ? "cost model" : "forced",
+					stats->n_est, stats->r_local, stats->n_local, stats->d_local,
+					stats->s_rows, stats->rows_per_key, stats->row_width,
+					stats->num_columns, stats->fetch_size,
+					(long long) get_max_filter_bytes()),
+			 errdetail("cost model %s\nexpected remote rows: %.1f (index %.3f ms, filter %.3f ms)\nsub-SELECT: %s",
+					   winner_line != NULL ? winner_line : "report not available",
+					   c->hint.expected_rows, c->hint.index_ms, c->hint.filter_ms,
+					   sql)));
+}
+
+/*
+ * plan_semijoin
+ *
+ * What it does: steps 2 to 5 for a candidate: statistics, estimate of n,
+ * the decision, and the new condition.
+ *
+ * Inputs:  q - the query; c - the candidate
+ * Output:  the new condition to add to WHERE, or NULL (with
+ *          c->reject_reason) if the query should stay unchanged
+ *
+ * Why it exists: it keeps all the work in one place, so that the caller
+ * can run it "protected" (see try_plan_semijoin).
+ */
+static Node *
+plan_semijoin(Query *q, SjbCandidate *c)
+{
+	SjbStats	stats;
+	int			path;
+	Node	   *condition;
+	char	   *sql = NULL;
+
+	memset(&stats, 0, sizeof(stats));
+	c->sjbloom_schema = get_namespace_name(get_extension_schema(c->sjbloom_oid));
+	if (c->sjbloom_schema == NULL)
+	{
+		c->reject_reason = "the schema of sjbloom was not found";
+		return NULL;
+	}
+
+	if (!collect_remote_stats(q, c, &stats))
+		return NULL;
+	estimate_local_keys(c, &stats);
+
+	path = decide_path(c, &stats);
+	if (path == SEMIJOIN_PATH_INDEX)
+		condition = build_index_condition(c, &sql);
+	else if (path == SEMIJOIN_PATH_FILTER)
+		condition = build_filter_condition(c, &stats, &sql);
+	else
+		return NULL;
+
+	if (condition == NULL)
+		return NULL;
+
+	fill_hint(c, &stats, path);
+	if (pgfdw_semijoin_verbose)
+		report_decision(c, &stats, path, sql);
+	return condition;
+}
+
+/*
+ * try_plan_semijoin
+ *
+ * What it does: runs plan_semijoin inside a "subtransaction". If any
+ * error happens inside, it is caught, the subtransaction is rolled back
+ * (this undoes locks and frees resources), and NULL is returned.
+ *
+ * Inputs:  q - the query; c - the candidate
+ * Output:  the new condition, or NULL
+ *
+ * Why it exists: our feature must never make a user's query fail. In
+ * PostgreSQL an error can only be caught safely together with a
+ * subtransaction (PL/pgSQL's EXCEPTION blocks work the same way).
+ * A query cancel (Ctrl-C) is not our error, so it is passed on.
+ */
+static Node *
+try_plan_semijoin(Query *q, SjbCandidate *c)
+{
+	MemoryContext old_context = CurrentMemoryContext;
+	ResourceOwner old_owner = CurrentResourceOwner;
+	Node	   *condition = NULL;
+
+	/*
+	 * BeginInternalSubTransaction switches to the subtransaction's memory;
+	 * we switch back, so that the new condition survives the end of the
+	 * subtransaction.
+	 */
+	BeginInternalSubTransaction(NULL);
+	MemoryContextSwitchTo(old_context);
+
+	PG_TRY();
+	{
+		condition = plan_semijoin(q, c);
+
+		/* success: end the subtransaction, keeping its work */
+		ReleaseCurrentSubTransaction();
+		MemoryContextSwitchTo(old_context);
+		CurrentResourceOwner = old_owner;
+	}
+	PG_CATCH();
+	{
+		ErrorData  *error;
+
+		/* save the error, then clear it and roll back */
+		MemoryContextSwitchTo(old_context);
+		error = CopyErrorData();
+		FlushErrorState();
+		RollbackAndReleaseCurrentSubTransaction();
+		MemoryContextSwitchTo(old_context);
+		CurrentResourceOwner = old_owner;
+
+		if (error->sqlerrcode == ERRCODE_QUERY_CANCELED)
+			ReThrowError(error);
+
+		condition = NULL;
+		c->reject_reason = psprintf("internal problem, query left unchanged: %s",
+									error->message);
+		c->always_report = true;
+		FreeErrorData(error);
+	}
+	PG_END_TRY();
+
+	return condition;
+}
+
+/* ------------------------------------------------------------------------
+ * Batch 7: the row estimate of the rewritten foreign scan
+ * ------------------------------------------------------------------------
+ */
+
+/*
+ * is_join_column_var
+ *
+ * What it does: checks that a node is the foreign table's join column.
+ * Inputs:  node - an expression; hint - the hint; relid - the foreign
+ *          table's number in the planner's range table
+ * Output:  true or false
+ * Why it exists: our condition always has the join column as one argument.
+ */
+static bool
+is_join_column_var(Node *node, SemijoinHint *hint, Index relid)
+{
+	Var		   *var;
+
+	if (node == NULL || !IsA(node, Var))
+		return false;
+	var = (Var *) node;
+	return var->varno == relid && var->varattno == hint->foreign_attno &&
+		var->varlevelsup == 0;
+}
+
+/*
+ * is_initplan_param
+ *
+ * What it does: checks that a node is a PARAM_EXEC parameter, which is
+ * what our "(SELECT ...)" has become: the planner turned it into an
+ * InitPlan whose result is this parameter.
+ * Input:  node - an expression
+ * Output: true or false
+ * Why it exists: our condition always has it as the other argument.
+ */
+static bool
+is_initplan_param(Node *node)
+{
+	return node != NULL && IsA(node, Param) &&
+		((Param *) node)->paramkind == PARAM_EXEC;
+}
+
+/*
+ * is_semijoin_clause
+ *
+ * What it does: recognises OUR condition among the conditions of the
+ * foreign table, as the planner sees it:
+ *   index path:  join_column = ANY ($n)
+ *   filter path: sjb_contains($n, join_column)
+ *
+ * Inputs:  clause - one condition; hint; relid - see is_join_column_var
+ * Output:  true if it is our condition
+ *
+ * Why it exists: its selectivity is replaced by our expected rows, while
+ * all other conditions keep their normal selectivity.
+ */
+static bool
+is_semijoin_clause(Node *clause, SemijoinHint *hint, Index relid)
+{
+	if (hint->path == SEMIJOIN_PATH_INDEX && IsA(clause, ScalarArrayOpExpr))
+	{
+		ScalarArrayOpExpr *any_expr = (ScalarArrayOpExpr *) clause;
+
+		return any_expr->opno == Int4EqualOperator && any_expr->useOr &&
+			list_length(any_expr->args) == 2 &&
+			is_join_column_var((Node *) linitial(any_expr->args), hint, relid) &&
+			is_initplan_param((Node *) lsecond(any_expr->args));
+	}
+
+	if (hint->path == SEMIJOIN_PATH_FILTER && IsA(clause, FuncExpr))
+	{
+		FuncExpr   *func = (FuncExpr *) clause;
+
+		return func->funcid == hint->contains_funcid &&
+			list_length(func->args) == 2 &&
+			is_initplan_param((Node *) linitial(func->args)) &&
+			is_join_column_var((Node *) lsecond(func->args), hint, relid);
+	}
+	return false;
+}
+
+/*
+ * pgfdw_apply_semijoin_hint
+ *
+ * What it does: called by postgresGetForeignRelSize, right after
+ * PostgreSQL's normal estimate set_baserel_size_estimates. If this is the
+ * foreign table our hook rewrote, it replaces the row estimate:
+ *     baserel->rows = expected_rows * (selectivity of the OTHER conditions)
+ * The planner cannot see inside "= ANY ($n)" (it guesses ~10 rows) or
+ * sjb_contains (it guesses 1/3 of the table); our cost model knows better.
+ * postgres_fdw derives everything else (fpinfo->rows, retrieved_rows, the
+ * per-row costs) from baserel->rows, so this is the only value we change.
+ *
+ * It does nothing unless ALL of these hold:
+ *   - a hint is set (only while our rewritten query is planned),
+ *   - its OID is this foreign table's,
+ *   - root->query_level == 1: the top-level query, never a subquery,
+ *   - our own condition is found among the table's conditions.
+ *
+ * Inputs:  root - the planner's state; baserel - the foreign table;
+ *          foreigntableid - its OID
+ * Output:  none (baserel->rows may change)
+ *
+ * Why it exists: with ~10 estimated rows the planner picked a Nested Loop
+ * with a Join Filter at n <= 1000 instead of a Hash Join.
+ */
+void
+pgfdw_apply_semijoin_hint(PlannerInfo *root, RelOptInfo *baserel,
+						  Oid foreigntableid)
+{
+	SemijoinHint *hint = pgfdw_semijoin_hint;
+	List	   *other_clauses = NIL;
+	bool		found = false;
+	Selectivity other_selectivity;
+	double		old_rows = baserel->rows;
+	ListCell   *cell;
+
+	if (hint == NULL || hint->foreign_relid != foreigntableid ||
+		root->query_level != 1)
+		return;
+
+	/* split the table's conditions into ours and the others */
+	foreach(cell, baserel->baserestrictinfo)
+	{
+		/* lfirst_node = lfirst, plus a check of the node type */
+		RestrictInfo *rinfo = lfirst_node(RestrictInfo, cell);
+
+		if (!found && is_semijoin_clause((Node *) rinfo->clause, hint, baserel->relid))
+			found = true;
+		else
+			other_clauses = lappend(other_clauses, rinfo);
+	}
+	if (!found)
+		return;
+
+	/* the planner's normal selectivity of all the other conditions */
+	other_selectivity = clauselist_selectivity(root, other_clauses,
+											   baserel->relid, JOIN_INNER, NULL);
+
+	/* clamp_row_est rounds and keeps the estimate at least 1 */
+	baserel->rows = clamp_row_est(hint->expected_rows * other_selectivity);
+
+	if (pgfdw_semijoin_verbose)
+		ereport(NOTICE,
+				(errmsg("semijoin: foreign scan rows %.0f -> %.0f",
+						old_rows, baserel->rows)));
+}
+
+/* ------------------------------------------------------------------------
+ * Batch 7: our decision in EXPLAIN
+ * ------------------------------------------------------------------------
+ */
+
+/*
+ * Positions inside our own list, which postgresGetForeignPlan stores in
+ * the ForeignScan's fdw_private at position FdwScanPrivateSemijoin.
+ * Only plain node types (Integer, Float) are used, so the plan can be
+ * copied and saved like any other plan.
+ */
+enum SemijoinPrivateIndex
+{
+	SemijoinPrivatePath,		/* Integer: SEMIJOIN_PATH_INDEX or _FILTER */
+	SemijoinPrivateKeys,		/* Float: n_est */
+	SemijoinPrivateIndexMs,		/* Float: predicted time, index path */
+	SemijoinPrivateFilterMs,	/* Float: predicted time, filter path */
+	SemijoinPrivateParamIndex,	/* Integer: our parameter ($n is n-1), or -1 */
+};
+
+/*
+ * Layout of the 24-byte filter header written by sjbloom (see
+ * sjbloom/sjb_filter.h in the project): version uint8, mode uint8,
+ * k uint16, nkeys uint32, m uint64, seed uint64. sjbloom writes it with
+ * memcpy in the machine's byte order; site A built the filter, so we read
+ * it back the same way.
+ */
+#define SJB_HEADER_SIZE 24
+#define SJB_HEADER_VERSION 3
+#define SJB_OFFSET_VERSION 0
+#define SJB_OFFSET_MODE 1
+#define SJB_OFFSET_K 2
+#define SJB_OFFSET_NKEYS 4
+#define SJB_OFFSET_M 8
+
+/*
+ * pgfdw_semijoin_plan_info
+ *
+ * What it does: called by postgresGetForeignPlan. If our hook rewrote this
+ * foreign scan, it returns a small List with the decision (path, n_est,
+ * both predicted times) and the position of our parameter among the
+ * scan's parameters ($1, $2, ...), so that EXPLAIN can show them later.
+ *
+ * Inputs:  root, foreignrel - the planner's state and the foreign table
+ *          remote_conds     - the conditions sent to site B (RestrictInfos)
+ *          params_list      - the parameters of the remote query, in order
+ * Output:  the List, or NIL if this scan was not rewritten
+ *
+ * Why it exists: the hint only lives while the query is planned, but
+ * EXPLAIN runs later, from the finished plan. So the values are copied
+ * into the plan itself.
+ */
+List *
+pgfdw_semijoin_plan_info(PlannerInfo *root, RelOptInfo *foreignrel,
+						 List *remote_conds, List *params_list)
+{
+	SemijoinHint *hint = pgfdw_semijoin_hint;
+	RangeTblEntry *rte;
+	Node	   *our_param = NULL;
+	int			param_index = -1;
+	int			position;
+	ListCell   *cell;
+
+	if (hint == NULL || root->query_level != 1 ||
+		foreignrel->reloptkind != RELOPT_BASEREL)
+		return NIL;
+
+	/* planner_rt_fetch: the range table entry of this relation */
+	rte = planner_rt_fetch(foreignrel->relid, root);
+	if (rte->relid != hint->foreign_relid)
+		return NIL;
+
+	/* find our condition, and in it our parameter */
+	foreach(cell, remote_conds)
+	{
+		RestrictInfo *rinfo = lfirst_node(RestrictInfo, cell);
+		List	   *args;
+
+		if (!is_semijoin_clause((Node *) rinfo->clause, hint, foreignrel->relid))
+			continue;
+		if (IsA(rinfo->clause, ScalarArrayOpExpr))
+			args = ((ScalarArrayOpExpr *) rinfo->clause)->args;
+		else
+			args = ((FuncExpr *) rinfo->clause)->args;
+		our_param = (hint->path == SEMIJOIN_PATH_INDEX) ? lsecond(args) : linitial(args);
+		break;
+	}
+	if (our_param == NULL)
+		return NIL;				/* our condition is not sent to site B */
+
+	/* its position among the remote query's parameters */
+	position = 0;
+	foreach(cell, params_list)
+	{
+		/* equal() compares two node trees */
+		if (equal(lfirst(cell), our_param))
+		{
+			param_index = position;
+			break;
+		}
+		position++;
+	}
+
+	/* makeInteger / makeFloat wrap a number as a node (Float keeps text) */
+	return list_make5(makeInteger(hint->path),
+					  makeFloat(psprintf("%.17g", hint->n_est)),
+					  makeFloat(psprintf("%.17g", hint->index_ms)),
+					  makeFloat(psprintf("%.17g", hint->filter_ms)),
+					  makeInteger(param_index));
+}
+
+/*
+ * pgfdw_semijoin_info_path / pgfdw_semijoin_info_param_index
+ *
+ * What they do: read the path and the parameter position back from the
+ * List made by pgfdw_semijoin_plan_info.
+ * Input:  info - that List
+ * Output: the path / the parameter position (-1 = unknown)
+ * Why they exist: postgres_fdw.c should not need to know the List's
+ * layout.
+ */
+int
+pgfdw_semijoin_info_path(List *info)
+{
+	return intVal(list_nth(info, SemijoinPrivatePath));
+}
+
+int
+pgfdw_semijoin_info_param_index(List *info)
+{
+	return intVal(list_nth(info, SemijoinPrivateParamIndex));
+}
+
+/*
+ * hex_digit_value
+ *
+ * What it does: the value 0-15 of one hex digit, or -1 if it is not one.
+ * Input:  digit - a character
+ * Output: its value, or -1
+ * Why it exists: a bytea parameter is sent as hex text ("\x0301...").
+ */
+static int
+hex_digit_value(char digit)
+{
+	if (digit >= '0' && digit <= '9')
+		return digit - '0';
+	if (digit >= 'a' && digit <= 'f')
+		return digit - 'a' + 10;
+	if (digit >= 'A' && digit <= 'F')
+		return digit - 'A' + 10;
+	return -1;
+}
+
+/*
+ * decode_filter
+ *
+ * What it does: reads the 24-byte sjbloom header of a filter and
+ * describes it, e.g. "mode=bloom keys=95017 m=1471893 k=10
+ * bytes_sent=184014".
+ *
+ * Inputs:  value   - the parameter as sent: hex text ("\x" + hex
+ *                    digits), or the raw bytes if binary
+ *          length  - number of raw bytes (binary only)
+ *          binary  - true if the filter was sent in binary (Batch 7)
+ *          runtime - the description is written here
+ * Output:  true if the value really is an sjbloom filter
+ *
+ * Why it exists: EXPLAIN ANALYZE shows what the filter really was, which
+ * sjb_build_auto only decided at run time.
+ */
+static bool
+decode_filter(const char *value, int length, bool binary, SemijoinRuntime *runtime)
+{
+	unsigned char header[SJB_HEADER_SIZE];
+	size_t		bytes_sent;
+	uint8		version;
+	uint8		mode;
+	uint16		k;
+	uint32		num_keys;
+	uint64		m;
+	int			i;
+
+	if (binary)
+	{
+		/* the raw bytes: the header is simply the first 24 of them */
+		if (length < SJB_HEADER_SIZE)
+			return false;
+		memcpy(header, value, SJB_HEADER_SIZE);
+		bytes_sent = length;
+	}
+	else
+	{
+		/* hex text: two hex digits per byte, after "\x" */
+		bytes_sent = strlen(value);
+		if (bytes_sent < 2 + 2 * SJB_HEADER_SIZE || value[0] != '\\' || value[1] != 'x')
+			return false;
+
+		for (i = 0; i < SJB_HEADER_SIZE; i++)
+		{
+			int			high = hex_digit_value(value[2 + 2 * i]);
+			int			low = hex_digit_value(value[2 + 2 * i + 1]);
+
+			if (high < 0 || low < 0)
+				return false;
+			header[i] = (unsigned char) (high * 16 + low);
+		}
+	}
+
+	/* read the fields with memcpy, never by casting pointers */
+	memcpy(&version, header + SJB_OFFSET_VERSION, sizeof(version));
+	memcpy(&mode, header + SJB_OFFSET_MODE, sizeof(mode));
+	memcpy(&k, header + SJB_OFFSET_K, sizeof(k));
+	memcpy(&num_keys, header + SJB_OFFSET_NKEYS, sizeof(num_keys));
+	memcpy(&m, header + SJB_OFFSET_M, sizeof(m));
+
+	if (version != SJB_HEADER_VERSION)
+		return false;
+
+	if (mode == 1)
+		snprintf(runtime->description, sizeof(runtime->description),
+				 "mode=bloom keys=%u m=%llu k=%u bytes_sent=%zu%s",
+				 (unsigned int) num_keys, (unsigned long long) m,
+				 (unsigned int) k, bytes_sent, binary ? " (binary)" : "");
+	else if (mode == 2)
+		snprintf(runtime->description, sizeof(runtime->description),
+				 "mode=exact keys=%u bytes_sent=%zu%s",
+				 (unsigned int) num_keys, bytes_sent, binary ? " (binary)" : "");
+	else if (mode == 3)
+		snprintf(runtime->description, sizeof(runtime->description),
+				 "mode=pass bytes_sent=%zu%s", bytes_sent, binary ? " (binary)" : "");
+	else
+		return false;
+	return true;
+}
+
+/*
+ * decode_key_list_text
+ *
+ * What it does: counts the elements of an int4[] in text form, e.g.
+ * "{12,345,6789}" has 3, and describes it: "3 bytes_sent=13".
+ *
+ * Inputs:  value - the parameter as sent; runtime - written here
+ * Output:  true if the text looks like an array
+ *
+ * Why it exists: EXPLAIN ANALYZE shows how many keys the index path sent.
+ */
+static bool
+decode_key_list_text(const char *value, SemijoinRuntime *runtime)
+{
+	size_t		length = strlen(value);
+	long		num_keys = 0;
+	size_t		i;
+
+	if (length < 2 || value[0] != '{' || value[length - 1] != '}')
+		return false;
+
+	if (length > 2)
+	{
+		num_keys = 1;			/* n elements are separated by n - 1 commas */
+		for (i = 1; i < length - 1; i++)
+		{
+			if (value[i] == ',')
+				num_keys++;
+		}
+	}
+
+	snprintf(runtime->description, sizeof(runtime->description),
+			 "%ld bytes_sent=%zu", num_keys, length);
+	return true;
+}
+
+/*
+ * pgfdw_semijoin_decode_param
+ *
+ * What it does: called by create_cursor with the value of our parameter,
+ * just before it is sent; describes it for EXPLAIN ANALYZE.
+ *
+ * Inputs:  value   - the parameter's text, or its raw bytes if binary
+ *                    (NULL if the value is NULL)
+ *          length  - number of raw bytes (binary only, else -1)
+ *          binary  - true if sent in binary (semijoin_binary_filter)
+ *          path    - SEMIJOIN_PATH_INDEX or SEMIJOIN_PATH_FILTER
+ *          runtime - filled in; runtime->decoded = false if the value
+ *                    could not be read ("unavailable")
+ * Output:  none. It never raises an error.
+ *
+ * Why it exists: to show what really happened at run time.
+ */
+void
+pgfdw_semijoin_decode_param(const char *value, int length, bool binary,
+							int path, SemijoinRuntime *runtime)
+{
+	runtime->decoded = false;
+	if (value == NULL)
+		return;
+
+	if (path == SEMIJOIN_PATH_FILTER)
+		runtime->decoded = decode_filter(value, length, binary, runtime);
+	else if (!binary)
+		runtime->decoded = decode_key_list_text(value, runtime);
+}
+
+/*
+ * pgfdw_semijoin_explain
+ *
+ * What it does: adds our lines to EXPLAIN of a rewritten foreign scan:
+ *     Semijoin Path: index | filter
+ *     Semijoin Estimated Keys: <n_est>
+ *     Semijoin Predicted Time: index=<ms> filter=<ms>
+ * and with ANALYZE what was really sent:
+ *     Semijoin Filter: mode=... keys=... m=... k=... bytes_sent=...
+ *     Semijoin Keys Sent: <number of keys> bytes_sent=...
+ *
+ * Inputs:  info    - the List made by pgfdw_semijoin_plan_info
+ *          runtime - filled in by create_cursor, or NULL (plain EXPLAIN)
+ *          es      - EXPLAIN's state
+ * Output:  none
+ *
+ * Why it exists: so a user can see in EXPLAIN what our hook decided.
+ */
+void
+pgfdw_semijoin_explain(List *info, SemijoinRuntime *runtime, ExplainState *es)
+{
+	int			path = intVal(list_nth(info, SemijoinPrivatePath));
+	double		n_est = floatVal(list_nth(info, SemijoinPrivateKeys));
+	double		index_ms = floatVal(list_nth(info, SemijoinPrivateIndexMs));
+	double		filter_ms = floatVal(list_nth(info, SemijoinPrivateFilterMs));
+	const char *runtime_text = "unavailable";
+
+	/* ExplainPropertyText / ...Float add one "Label: value" line */
+	ExplainPropertyText("Semijoin Path",
+						path == SEMIJOIN_PATH_INDEX ? "index" : "filter", es);
+	ExplainPropertyFloat("Semijoin Estimated Keys", NULL, n_est, 0, es);
+	ExplainPropertyText("Semijoin Predicted Time",
+						psprintf("index=%.3f ms filter=%.3f ms", index_ms, filter_ms),
+						es);
+
+	if (!es->analyze)
+		return;
+
+	if (runtime != NULL && runtime->decoded)
+		runtime_text = runtime->description;
+	ExplainPropertyText(path == SEMIJOIN_PATH_FILTER ? "Semijoin Filter" : "Semijoin Keys Sent",
+						runtime_text, es);
+}
+
+/*
+ * attach_condition
+ *
+ * What it does: the ONLY change we ever make to the user's query: it adds
+ * "AND <condition>" to WHERE. make_and_qual(a, b) builds "a AND b" (or
+ * just b if there was no WHERE).
+ *
+ * Inputs:  q - the user's query; condition - the finished new condition
+ * Output:  none (q is changed)
+ *
+ * Why it exists: it must be the very LAST step, run only after all steps
+ * that can fail (statistics, parsing, planning the estimate, the cost
+ * model) have finished. Those steps run in try_plan_semijoin, and if one
+ * fails its error is caught there and the query is planned without our
+ * condition. That is only correct if the query is then truly unchanged:
+ * a query changed halfway (for example a condition added but hasSubLinks
+ * not set) could give a wrong plan or a crash. So all earlier steps only
+ * READ q (local conditions are copied with copyObject before their Vars
+ * are renumbered, and the foreign Var is copied too), and here the new
+ * WHERE is first built completely and then stored with two plain
+ * assignments, which cannot fail.
+ */
+static void
+attach_condition(Query *q, Node *condition)
+{
+	Node	   *new_quals = make_and_qual(q->jointree->quals, condition);
+
+	q->jointree->quals = new_quals;
+	q->hasSubLinks = true;		/* the condition contains a sub-SELECT */
+}
+
+/*
+ * pgfdw_semijoin_planner
+ *
+ * What it does: our planner hook. PostgreSQL calls it for every query it
+ * plans. If the semijoin feature is on and the query is a candidate, it
+ * adds the new condition to the query's WHERE (steps 2-5). Then it ALWAYS
+ * lets the normal planner plan the (maybe changed) query.
+ *
+ * Inputs:  the same as standard_planner (see planner_hook_type in
+ *          src/include/optimizer/planner.h)
+ * Output:  the finished plan
+ *
+ * Why it exists: a planner hook is the place where we can change a query
+ * before PostgreSQL plans it.
+ */
+PlannedStmt *
+pgfdw_semijoin_planner(Query *parse, const char *query_string,
+					   int cursorOptions, ParamListInfo boundParams)
+{
+	/*
+	 * In parallel mode (for example a parallel worker planning a query of a
+	 * function) we do nothing. Our rewrite runs in a subtransaction, and
+	 * PostgreSQL only allows subtransactions during a parallel operation if
+	 * they assign no new transaction ID or command ID (see
+	 * BeginInternalSubTransaction in src/backend/access/transam/xact.c);
+	 * breaking that rule is an error we could not hide. So we never start a
+	 * subtransaction there.
+	 */
+	SemijoinHint my_hint;
+	SemijoinHint *saved_hint = pgfdw_semijoin_hint;
+	PlannedStmt *result;
+
+	/* no hint unless this query is rewritten below */
+	memset(&my_hint, 0, sizeof(my_hint));
+	my_hint.foreign_relid = InvalidOid;
+
+	if (pgfdw_enable_semijoin && !in_semijoin_hook && !IsInParallelMode())
+	{
+		SjbCandidate candidate;
+		Node	   *condition = NULL;
+
+		/*
+		 * PG_TRY / PG_FINALLY: if an error happens inside, the FINALLY part
+		 * still runs (and then the error continues). This makes sure the
+		 * flag is reset even after an error.
+		 */
+		in_semijoin_hook = true;
+		PG_TRY();
+		{
+			if (find_candidate(parse, &candidate))
+				condition = try_plan_semijoin(parse, &candidate);
+
+			if (condition != NULL)
+			{
+				my_hint = candidate.hint;	/* may be empty: see fill_hint */
+				attach_condition(parse, condition);	/* last step */
+			}
+			else if (candidate.uses_foreign_table &&
+					 (pgfdw_semijoin_verbose || candidate.always_report))
+				ereport(NOTICE,
+						(errmsg("postgres_fdw semijoin: no rewrite: %s",
+								candidate.reject_reason)));
+		}
+		PG_FINALLY();
+		{
+			in_semijoin_hook = false;
+		}
+		PG_END_TRY();
+	}
+
+	/*
+	 * Batch 7: make our hint (or NULL, if this query was not rewritten)
+	 * visible while THIS query is planned, and put the previous value back
+	 * afterwards, even after an error. So a query planned inside this one
+	 * (or the next query) never sees our hint. my_hint lives on our stack,
+	 * which is fine: it is only used during the call below.
+	 */
+	pgfdw_semijoin_hint = OidIsValid(my_hint.foreign_relid) ? &my_hint : NULL;
+	PG_TRY();
+	{
+		if (prev_planner_hook != NULL)
+			result = prev_planner_hook(parse, query_string, cursorOptions, boundParams);
+		else
+			result = standard_planner(parse, query_string, cursorOptions, boundParams);
+	}
+	PG_FINALLY();
+	{
+		pgfdw_semijoin_hint = saved_hint;
+	}
+	PG_END_TRY();
+
+	return result;
+}
diff --git a/contrib/postgres_fdw/sql/semijoin.sql b/contrib/postgres_fdw/sql/semijoin.sql
new file mode 100644
index 0000000000..4931514771
--- /dev/null
+++ b/contrib/postgres_fdw/sql/semijoin.sql
@@ -0,0 +1,255 @@
+-- ===================================================================
+-- CS631: tests of the automatic semijoin rewrite (semijoin.c).
+--
+-- Needs the sjbloom extension (CS631 project), which plain PostgreSQL does
+-- not have, so this test is NOT in the default REGRESS list. Run it with:
+--     make installcheck REGRESS=semijoin
+--
+-- A loopback server plays "site B": the "remote" table lives in schema
+-- sj_remote of this same database, and ft_customers points to it.
+-- ===================================================================
+
+-- ===================================================================
+-- Step 0: fixed values for every cost constant and the network speed,
+-- so the expected output never depends on a future recalibration (the
+-- values are the current defaults, from results/calibration.json). They
+-- are set before postgres_fdw is loaded; it takes them over when it
+-- defines its settings.
+-- ===================================================================
+SET postgres_fdw.semijoin_network_mbit = 1000;
+SET postgres_fdw.semijoin_t_check_ns = 158.19;
+SET postgres_fdw.semijoin_t_lookup_us = 4.7956;
+SET postgres_fdw.semijoin_per_message_ms = 0.06194;
+SET postgres_fdw.semijoin_per_row_us = 0.54819;
+SET postgres_fdw.semijoin_t_build_us = 0.245;
+SET postgres_fdw.semijoin_max_filter_kb = 1024;
+SET postgres_fdw.semijoin_binary_filter = off;
+
+-- ===================================================================
+-- Step 1: extensions, loopback server, user mapping
+-- ===================================================================
+CREATE EXTENSION postgres_fdw;
+CREATE EXTENSION sjbloom;
+-- make sure our planner hook is installed in this session
+LOAD 'postgres_fdw';
+
+DO $d$
+    BEGIN
+        EXECUTE $$CREATE SERVER sj_loopback FOREIGN DATA WRAPPER postgres_fdw
+            OPTIONS (dbname '$$||current_database()||$$',
+                     port '$$||current_setting('port')||$$'
+            )$$;
+    END;
+$d$;
+CREATE USER MAPPING FOR CURRENT_USER SERVER sj_loopback;
+
+-- the filter functions may be sent to the "remote" side, and the rewrite
+-- is opted in for this server
+ALTER SERVER sj_loopback OPTIONS (ADD extensions 'sjbloom', ADD semijoin_filter 'true');
+
+-- ===================================================================
+-- Step 2: small tables. Customers 1..2000 at the "remote" side; 300
+-- orders whose customer_id is sometimes NULL (every 10th order) and
+-- sometimes a customer that does not exist (2001..2500).
+-- ===================================================================
+CREATE SCHEMA sj_remote;
+CREATE TABLE sj_remote.customers (
+    id   int PRIMARY KEY,
+    name text,
+    city text
+);
+INSERT INTO sj_remote.customers
+SELECT g, 'customer ' || g, 'city ' || (g % 10)
+FROM generate_series(1, 2000) AS g;
+
+CREATE FOREIGN TABLE ft_customers (id int, name text, city text)
+    SERVER sj_loopback OPTIONS (schema_name 'sj_remote', table_name 'customers');
+
+CREATE TABLE orders_l (
+    order_id    int PRIMARY KEY,
+    customer_id int,
+    amount      int
+);
+INSERT INTO orders_l
+SELECT g,
+       CASE WHEN g % 10 = 0 THEN NULL ELSE (g * 37) % 2500 + 1 END,
+       g % 97
+FROM generate_series(1, 300) AS g;
+
+-- the hook needs statistics of both tables
+ANALYZE sj_remote.customers;
+ANALYZE ft_customers;
+ANALYZE orders_l;
+
+-- ===================================================================
+-- Step 3: a helper for the correctness checks. It runs a query into a
+-- temp table with the rewrite off and again with it on, and compares
+-- the two with EXCEPT ALL in both directions (duplicates count).
+-- (A single "query EXCEPT ALL query" is a set operation, which the
+-- hook never rewrites.) Both counts must be 0.
+-- ===================================================================
+CREATE FUNCTION sj_compare(query text,
+                           OUT on_rows bigint,
+                           OUT off_except_on bigint,
+                           OUT on_except_off bigint)
+LANGUAGE plpgsql AS $$
+BEGIN
+    SET LOCAL postgres_fdw.enable_semijoin = off;
+    EXECUTE 'CREATE TEMP TABLE sj_off AS ' || query;
+    SET LOCAL postgres_fdw.enable_semijoin = on;
+    EXECUTE 'CREATE TEMP TABLE sj_on AS ' || query;
+    SET LOCAL postgres_fdw.enable_semijoin = off;
+    SELECT count(*) INTO on_rows FROM sj_on;
+    SELECT count(*) INTO off_except_on
+        FROM (SELECT * FROM sj_off EXCEPT ALL SELECT * FROM sj_on) AS d;
+    SELECT count(*) INTO on_except_off
+        FROM (SELECT * FROM sj_on EXCEPT ALL SELECT * FROM sj_off) AS d;
+    DROP TABLE sj_off, sj_on;
+END;
+$$;
+
+-- A helper for EXPLAIN ANALYZE: shows only the lines of the foreign scan
+-- that matter here, so memory sizes and the like cannot change the output.
+CREATE FUNCTION sj_explain_analyze(query text) RETURNS SETOF text
+LANGUAGE plpgsql AS $$
+DECLARE
+    line text;
+BEGIN
+    FOR line IN EXECUTE 'EXPLAIN (ANALYZE, VERBOSE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) ' || query
+    LOOP
+        IF line ~ '(Foreign Scan|Remote SQL|Semijoin)' THEN
+            RETURN NEXT line;
+        END IF;
+    END LOOP;
+END;
+$$;
+
+-- ===================================================================
+-- Step 4: the rewrite is visible in EXPLAIN, and can be turned off
+-- ===================================================================
+-- the cost model's choice (auto)
+EXPLAIN (VERBOSE, COSTS OFF)
+SELECT o.order_id, c.name
+FROM orders_l o JOIN ft_customers c ON c.id = o.customer_id
+WHERE o.order_id <= 50;
+
+-- off: the original plan, all customers are fetched
+SET postgres_fdw.enable_semijoin = off;
+EXPLAIN (VERBOSE, COSTS OFF)
+SELECT o.order_id, c.name
+FROM orders_l o JOIN ft_customers c ON c.id = o.customer_id
+WHERE o.order_id <= 50;
+RESET postgres_fdw.enable_semijoin;
+
+-- ===================================================================
+-- Step 5: force_path index and filter
+-- ===================================================================
+SET postgres_fdw.semijoin_force_path = index;
+EXPLAIN (VERBOSE, COSTS OFF)
+SELECT o.order_id, c.name
+FROM orders_l o JOIN ft_customers c ON c.id = o.customer_id
+WHERE o.order_id <= 50;
+
+SET postgres_fdw.semijoin_force_path = filter;
+EXPLAIN (VERBOSE, COSTS OFF)
+SELECT o.order_id, c.name
+FROM orders_l o JOIN ft_customers c ON c.id = o.customer_id
+WHERE o.order_id <= 50;
+
+-- EXPLAIN ANALYZE shows what was really sent
+SET postgres_fdw.semijoin_force_path = index;
+SELECT sj_explain_analyze($$SELECT o.order_id, c.name FROM orders_l o JOIN ft_customers c ON c.id = o.customer_id WHERE o.order_id <= 50$$);
+
+SET postgres_fdw.semijoin_force_path = filter;
+SELECT sj_explain_analyze($$SELECT o.order_id, c.name FROM orders_l o JOIN ft_customers c ON c.id = o.customer_id WHERE o.order_id <= 50$$);
+
+-- the same filter in binary (about half the bytes)
+SET postgres_fdw.semijoin_binary_filter = on;
+SELECT sj_explain_analyze($$SELECT o.order_id, c.name FROM orders_l o JOIN ft_customers c ON c.id = o.customer_id WHERE o.order_id <= 50$$);
+RESET postgres_fdw.semijoin_binary_filter;
+RESET postgres_fdw.semijoin_force_path;
+
+-- ===================================================================
+-- Step 6: correctness for every path. Some keys are NULL and some have
+-- no customer, so the join drops rows on both sides.
+-- ===================================================================
+-- the first one with verbose on: the NOTICEs show that the "on" run
+-- inside sj_compare really is rewritten (the "off" run prints nothing)
+SET postgres_fdw.semijoin_force_path = auto;
+SET postgres_fdw.semijoin_verbose = on;
+\set VERBOSITY terse
+SELECT * FROM sj_compare($$SELECT o.order_id, c.name FROM orders_l o JOIN ft_customers c ON c.id = o.customer_id WHERE o.order_id <= 200$$);
+\set VERBOSITY default
+RESET postgres_fdw.semijoin_verbose;
+SET postgres_fdw.semijoin_force_path = index;
+SELECT * FROM sj_compare($$SELECT o.order_id, c.name FROM orders_l o JOIN ft_customers c ON c.id = o.customer_id WHERE o.order_id <= 200$$);
+SET postgres_fdw.semijoin_force_path = filter;
+SELECT * FROM sj_compare($$SELECT o.order_id, c.name FROM orders_l o JOIN ft_customers c ON c.id = o.customer_id WHERE o.order_id <= 200$$);
+SET postgres_fdw.semijoin_binary_filter = on;
+SELECT * FROM sj_compare($$SELECT o.order_id, c.name FROM orders_l o JOIN ft_customers c ON c.id = o.customer_id WHERE o.order_id <= 200$$);
+RESET postgres_fdw.semijoin_binary_filter;
+
+-- ===================================================================
+-- Step 7: only NULL keys, and an empty local result. The key list or
+-- filter is then NULL, so no customer passes, and the join is empty.
+-- ===================================================================
+SET postgres_fdw.semijoin_force_path = index;
+SELECT * FROM sj_compare($$SELECT o.order_id, c.name FROM orders_l o JOIN ft_customers c ON c.id = o.customer_id WHERE o.customer_id IS NULL$$);
+SELECT * FROM sj_compare($$SELECT o.order_id, c.name FROM orders_l o JOIN ft_customers c ON c.id = o.customer_id WHERE o.order_id < 0$$);
+SET postgres_fdw.semijoin_force_path = filter;
+SELECT * FROM sj_compare($$SELECT o.order_id, c.name FROM orders_l o JOIN ft_customers c ON c.id = o.customer_id WHERE o.customer_id IS NULL$$);
+SELECT * FROM sj_compare($$SELECT o.order_id, c.name FROM orders_l o JOIN ft_customers c ON c.id = o.customer_id WHERE o.order_id < 0$$);
+RESET postgres_fdw.semijoin_force_path;
+
+-- ===================================================================
+-- Step 8: GROUP BY is rewritten too, and gives the same groups
+-- ===================================================================
+EXPLAIN (VERBOSE, COSTS OFF)
+SELECT c.city, count(*), sum(o.amount)
+FROM orders_l o JOIN ft_customers c ON c.id = o.customer_id
+WHERE o.order_id <= 100
+GROUP BY c.city;
+SELECT * FROM sj_compare($$SELECT c.city, count(*) AS num_orders, sum(o.amount) AS total FROM orders_l o JOIN ft_customers c ON c.id = o.customer_id WHERE o.order_id <= 100 GROUP BY c.city$$);
+
+-- ===================================================================
+-- Step 9: queries that must NOT be rewritten (verbose says why)
+-- ===================================================================
+SET postgres_fdw.semijoin_verbose = on;
+
+-- a LEFT JOIN needs the unmatched orders too
+EXPLAIN (VERBOSE, COSTS OFF)
+SELECT o.order_id, c.name
+FROM orders_l o LEFT JOIN ft_customers c ON c.id = o.customer_id
+WHERE o.order_id <= 50;
+
+-- a volatile local condition could pick other rows on the second read
+EXPLAIN (VERBOSE, COSTS OFF)
+SELECT o.order_id, c.name
+FROM orders_l o JOIN ft_customers c ON c.id = o.customer_id
+WHERE o.order_id <= 50 AND random() < 2;
+
+-- the table option semijoin_filter = false wins over the server's true
+ALTER FOREIGN TABLE ft_customers OPTIONS (ADD semijoin_filter 'false');
+EXPLAIN (VERBOSE, COSTS OFF)
+SELECT o.order_id, c.name
+FROM orders_l o JOIN ft_customers c ON c.id = o.customer_id
+WHERE o.order_id <= 50;
+ALTER FOREIGN TABLE ft_customers OPTIONS (DROP semijoin_filter);
+
+-- an invalid option value is rejected
+ALTER SERVER sj_loopback OPTIONS (SET semijoin_filter 'maybe');
+
+RESET postgres_fdw.semijoin_verbose;
+
+-- ===================================================================
+-- Step 10: clean up
+-- ===================================================================
+DROP FUNCTION sj_compare(text);
+DROP FUNCTION sj_explain_analyze(text);
+DROP FOREIGN TABLE ft_customers;
+DROP TABLE orders_l;
+DROP SCHEMA sj_remote CASCADE;
+DROP USER MAPPING FOR CURRENT_USER SERVER sj_loopback;
+DROP SERVER sj_loopback;
+DROP EXTENSION sjbloom;
+DROP EXTENSION postgres_fdw;
